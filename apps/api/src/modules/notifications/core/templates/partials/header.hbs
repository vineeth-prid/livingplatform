<div style="padding: 22px 28px 16px; border-bottom: 1px solid #eef0ee;">
  {{#if logo_url}}<img src="{{logo_url}}" alt="" width="40" height="40" style="width:40px;height:40px;border-radius:10px;vertical-align:middle;margin-right:10px;" />{{/if}}<span style="font-size: 20px; font-weight: 700; color: {{#if brand_color}}{{brand_color}}{{else}}#234b39{{/if}}; letter-spacing: -0.02em; vertical-align: middle;">{{#if brand_name}}{{brand_name}}{{else}}Living{{/if}}{{#unless branded}}<span style="color:#b96a43;">.</span>{{/unless}}</span>
</div>
