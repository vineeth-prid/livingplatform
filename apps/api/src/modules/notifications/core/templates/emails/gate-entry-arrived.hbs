Subject: {{headline}} at {{gateName}} for {{unitNumber}}
<h1>{{arrivalNoun}} at {{gateName}}</h1>
<p>{{t "greeting"}} {{residentName}},</p>
<p>{{leadIn}}</p>
<table role="presentation" style="margin:16px 0;font-size:14px;">
  {{#if vendorName}}<tr><td style="padding:2px 16px 2px 0;color:#6b7280;">Vendor</td><td><strong>{{vendorName}}</strong></td></tr>{{/if}}
  <tr><td style="padding:2px 16px 2px 0;color:#6b7280;">Apartment</td><td><strong>{{unitNumber}}</strong></td></tr>
  <tr><td style="padding:2px 16px 2px 0;color:#6b7280;">{{personLabel}}</td><td>{{personName}}{{#if mobileNumber}} · {{mobileNumber}}{{/if}}</td></tr>
  {{#if passCode}}<tr><td style="padding:2px 16px 2px 0;color:#6b7280;">Gate pass</td><td><strong style="font-family:ui-monospace,Menlo,monospace;">{{passCode}}</strong></td></tr>{{/if}}
  <tr><td style="padding:2px 16px 2px 0;color:#6b7280;">Time</td><td>{{arrivedAt}}</td></tr>
</table>
{{#if actionUrl}}<p style="margin: 20px 0;"><a class="btn" href="{{actionUrl}}">Approve or reject</a></p>{{/if}}
<p class="muted">Reference {{entryNumber}}. If you do not respond, security will hold {{holdNoun}} at the gate.</p>
