Subject: Payment received — {{currency}} {{amount}}
<h1>Payment received</h1>
<p>{{t "greeting"}} {{residentName}},</p>
<p>We have received <strong>{{currency}} {{amount}}</strong>{{#if invoiceNumber}} against invoice <strong>{{invoiceNumber}}</strong>{{/if}}.</p>
{{#if receiptNumber}}<p class="muted">Receipt {{receiptNumber}} · {{paidAt}}</p>{{/if}}
{{#if actionUrl}}<p style="margin: 20px 0;"><a class="btn" href="{{actionUrl}}">View receipt</a></p>{{/if}}
