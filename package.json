{
  "name": "living-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Living — a premium PropTech ecosystem. Life Happens Here.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "clean": "turbo run clean && rimraf node_modules",
    "audit:security": "pnpm audit --prod --audit-level high"
  },
  "devDependencies": {
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "body-parser@<1.20.9": "^1.20.9",
      "multer@<2.5.0": "^2.5.0",
      "proxy-addr@<2.0.8": "^2.0.8",
      "lodash@<4.18.0": "^4.18.1",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "seroval@<1.6.8": "^1.6.8",
      "handlebars@<4.7.10": "^4.7.10",
      "qs@>=6.0.0 <6.16.1": "^6.16.1",
      "uuid@>=11.0.0 <11.1.1": "^11.1.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ggr8-5vv4-36mx",
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  }
}
